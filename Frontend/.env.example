# Cloudflare Turnstile Public Site Key (DO NOT place Secret Key here)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
VITE_API_BASE_URL=http://localhost:5000/api/v1  # Use in production (e.g., https://api.qucodex.com/api/v1)

# CodeX Treasurer UPI ID for membership fee payment display
# Replace with the official UPI ID before going live
VITE_TREASURER_UPI_ID=your.treasurer@upi
